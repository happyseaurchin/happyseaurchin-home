{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/genus-clock?handle=egg-one",
      "schedule": "7 7,19 * * *"
    }
  ],
  "functions": {
    "api/genus-clock.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/at/:handle",
      "destination": "/at"
    },
    {
      "source": "/recency/:family",
      "destination": "/recency"
    },
    {
      "source": "/recency/:family/:handle",
      "destination": "/recency"
    },
    {
      "source": "/heatmap/:family",
      "destination": "/recency"
    },
    {
      "source": "/heatmap/:family/:handle",
      "destination": "/recency"
    },
    {
      "source": "/walk/:family",
      "destination": "/walk"
    },
    {
      "source": "/walk/:family/:handle",
      "destination": "/walk"
    },
    {
      "source": "/my-decks/:handle",
      "destination": "/my-decks"
    },
    {
      "source": "/hands",
      "destination": "/hands"
    },
    {
      "source": "/hands/:handle",
      "destination": "/hands"
    },
    {
      "source": "/ahead/:handle",
      "destination": "/ahead"
    },
    {
      "source": "/morning/:handle",
      "destination": "/morning"
    },
    {
      "source": "/across/:handle",
      "destination": "/across"
    },
    {
      "source": "/ledger/:handle",
      "destination": "/ledger"
    },
    {
      "source": "/now/:handle",
      "destination": "/now"
    },
    {
      "source": "/models/:handle",
      "destination": "/models"
    },
    {
      "source": "/here/:handle",
      "destination": "/here"
    },
    {
      "source": "/passport/:handle",
      "destination": "/self"
    },
    {
      "source": "/next/:handle",
      "destination": "/next"
    },
    {
      "source": "/today-beach-deck/:handle",
      "destination": "/next"
    },
    {
      "source": "/fold/:field",
      "destination": "/fold"
    },
    {
      "source": "/tree/:family",
      "destination": "/tree"
    },
    {
      "source": "/view/:name",
      "destination": "/view"
    },
    {
      "source": "/page/:handle",
      "destination": "/page"
    },
    {
      "source": "/group/:party",
      "destination": "/group"
    },
    {
      "source": "/rpg/:world",
      "destination": "/rpg"
    },
    {
      "source": "/network/:name",
      "destination": "/network"
    },
    {
      "source": "/field/:hands",
      "destination": "/field"
    },
    {
      "source": "/news",
      "destination": "/news"
    },
    {
      "source": "/news/:handle",
      "destination": "/news"
    },
    {
      "source": "/earth/:handle",
      "destination": "/earth"
    },
    {
      "source": "/globe/:handle",
      "destination": "/globe"
    },
    {
      "source": "/social-brain/:handle",
      "destination": "/social-brain"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/entrance2",
      "destination": "/entrance",
      "permanent": true
    },
    {
      "source": "/passport",
      "destination": "/welcome",
      "permanent": false
    },
    {
      "source": "/self",
      "destination": "/welcome",
      "permanent": false
    },
    {
      "source": "/shell/:handle",
      "destination": "/passport/:handle",
      "permanent": false
    },
    {
      "source": "/self/:handle",
      "destination": "/passport/:handle",
      "permanent": false
    },
    {
      "source": "/reach",
      "destination": "/social-brain",
      "permanent": false
    },
    {
      "source": "/reach/:handle",
      "destination": "/social-brain/:handle",
      "permanent": false
    },
    {
      "source": "/deeper",
      "destination": "/touch",
      "permanent": false
    },
    {
      "source": "/deeper.md",
      "destination": "/touch.md",
      "permanent": false
    },
    {
      "source": "/deeper.html",
      "destination": "/touch.html",
      "permanent": false
    },
    {
      "source": "/virtual-ai-agents/v2",
      "destination": "/virtual-ai-agents",
      "permanent": true
    },
    {
      "source": "/mindflow/zand-editor",
      "destination": "/mindflow/biome-editor/",
      "permanent": true
    },
    {
      "source": "/mindflow/zand-editor/:path(.*)",
      "destination": "/mindflow/biome-editor/:path",
      "permanent": true
    },
    {
      "source": "/mindflow/zand-filmstrip",
      "destination": "/mindflow/biome-filmstrip/",
      "permanent": true
    },
    {
      "source": "/mindflow/zand-filmstrip/:path(.*)",
      "destination": "/mindflow/biome-filmstrip/:path",
      "permanent": true
    },
    {
      "source": "/mindflow/zand.js",
      "destination": "/mindflow/biome.js",
      "permanent": true
    },
    {
      "source": "/flow",
      "destination": "/mindflow/flow/",
      "permanent": false
    }
  ]
}