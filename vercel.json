{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/genus-clock?handle=egg-one",
      "schedule": "7 7,19 * * *"
    }
  ],
  "functions": {
    "api/genus-clock.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/ahead/:handle",
      "destination": "/ahead"
    },
    {
      "source": "/at/:handle",
      "destination": "/at"
    },
    {
      "source": "/heatmap/:family",
      "destination": "/heatmap"
    },
    {
      "source": "/heatmap/:family/:handle",
      "destination": "/heatmap"
    },
    {
      "source": "/where/:family",
      "destination": "/where"
    },
    {
      "source": "/where/:family/:handle",
      "destination": "/where"
    },
    {
      "source": "/walk/:family",
      "destination": "/walk"
    },
    {
      "source": "/walk/:family/:handle",
      "destination": "/walk"
    },
    {
      "source": "/my-decks/:handle",
      "destination": "/my-decks"
    },
    {
      "source": "/morning/:handle",
      "destination": "/morning"
    },
    {
      "source": "/across/:handle",
      "destination": "/across"
    },
    {
      "source": "/ledger/:handle",
      "destination": "/ledger"
    },
    {
      "source": "/now/:handle",
      "destination": "/now"
    },
    {
      "source": "/next/:handle",
      "destination": "/next"
    },
    {
      "source": "/today-beach-deck/:handle",
      "destination": "/next"
    },
    {
      "source": "/fold/:field",
      "destination": "/fold"
    },
    {
      "source": "/tree/:family",
      "destination": "/tree"
    },
    {
      "source": "/view/:name",
      "destination": "/view"
    },
    {
      "source": "/network/:name",
      "destination": "/network"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/deeper",
      "destination": "/touch",
      "permanent": false
    },
    {
      "source": "/deeper.md",
      "destination": "/touch.md",
      "permanent": false
    },
    {
      "source": "/deeper.html",
      "destination": "/touch.html",
      "permanent": false
    },
    {
      "source": "/virtual-ai-agents/v2",
      "destination": "/virtual-ai-agents",
      "permanent": true
    },
    {
      "source": "/mindflow/zand-editor",
      "destination": "/mindflow/biome-editor/",
      "permanent": true
    },
    {
      "source": "/mindflow/zand-editor/:path(.*)",
      "destination": "/mindflow/biome-editor/:path",
      "permanent": true
    },
    {
      "source": "/mindflow/zand-filmstrip",
      "destination": "/mindflow/biome-filmstrip/",
      "permanent": true
    },
    {
      "source": "/mindflow/zand-filmstrip/:path(.*)",
      "destination": "/mindflow/biome-filmstrip/:path",
      "permanent": true
    },
    {
      "source": "/mindflow/zand.js",
      "destination": "/mindflow/biome.js",
      "permanent": true
    }
  ]
}