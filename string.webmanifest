{
  "name": "The String",
  "short_name": "String",
  "description": "Links people bring from anywhere, each with a line of why it caught them.",
  "start_url": "/string",
  "scope": "/string",
  "display": "standalone",
  "background_color": "#06171E",
  "theme_color": "#06171E",
  "icons": [
    { "src": "/assets/string/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/string/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/string/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/string",
    "method": "GET",
    "params": { "url": "add", "text": "addtext", "title": "addtitle" }
  }
}
