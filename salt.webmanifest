{
  "name": "SALT — the String",
  "short_name": "SALT",
  "description": "What SALT’s members are sharing, each link with a line of why it caught them.",
  "start_url": "/salt",
  "scope": "/salt",
  "display": "standalone",
  "background_color": "#06171E",
  "theme_color": "#06171E",
  "icons": [
    {
      "src": "/assets/string/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/string/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/string/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/salt",
    "method": "GET",
    "params": {
      "url": "add",
      "text": "addtext",
      "title": "addtitle"
    }
  }
}
